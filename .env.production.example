# ─────────────────────────────────────────────────────────────
#  PRODUCTION ENVIRONMENT VARIABLES
#
#  Copy this file to .env on the Azure VM:
#    cp .env.production.example .env
#
#  Fill in all values. This file is loaded by docker-compose.
#  NEVER commit the real .env to Git.
# ─────────────────────────────────────────────────────────────

# PostgreSQL credentials — must match docker-compose.yml postgres section
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=team12

# Full Prisma connection string (uses the Docker service name "postgres" as host)
DATABASE_URL=postgresql://postgres:root@postgres:5432/team12?schema=public

# JWT / session secret — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET

# Public URL of your Azure VM or domain (used by Next.js for absolute URLs)
NEXTAUTH_URL=NEXTAUTH_URL=http://4.188.84.115

# Node environment
NODE_ENV=production
